#!/bin/bash
# Wrapper to run LangForge GUI

# Use the canonical packaged path and a source-tree fallback.
LANGFORGE_DIR="/usr/share/langforge"
if [[ ! -f "$LANGFORGE_DIR/main.py" ]]; then
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    LANGFORGE_DIR="$SCRIPT_DIR/../share/langforge"
fi

exec python3 "$LANGFORGE_DIR/main.py" "$@"
