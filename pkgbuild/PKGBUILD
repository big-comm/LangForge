# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=langforge
pkgdesc="Automatic translation tool for gettext projects using AI-powered APIs"
depends=(
    'python'
    'python-gobject'
    'python-cairo'
    'python-requests'
    'python-polib'
    'libadwaita'
    'libsecret'
    'gtk4'
    'gettext'
    'python-openai'
    'python-google-genai'
)
checkdepends=('python-pytest')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/${pkgname}"
    # Add any preparation steps here, if needed
    # For example: patch -p1 < "${srcdir}/patch-file.patch"
}

build() {
    cd "${srcdir}/${pkgname}"
    local lang po
    for po in locale/*.po; do
        lang="${po##*/}"
        lang="${lang%.po}"
        lang="${lang/-/_}"
        install -d "usr/share/locale/${lang}/LC_MESSAGES"
        msgfmt --check --check-format --check-accelerators \
            -o "usr/share/locale/${lang}/LC_MESSAGES/langforge.mo" "${po}"
    done
}

check() {
    cd "${srcdir}/${pkgname}"
    pytest -q
    local po
    for po in locale/*.po; do
        msgfmt --check --check-format --check-accelerators \
            -o /dev/null "${po}"
    done
}

package() {
    cd "${srcdir}/${pkgname}"

    # Determine the correct source directory
    if [ -d "${pkgname}" ]; then
        srcdir="${srcdir}/${pkgname}/${pkgname}"
    else
        srcdir="${srcdir}/${pkgname}"
    fi

    # Install files
    local dirs=("usr" "etc" "opt")
    for dir in "${dirs[@]}"; do
        if [ -d "${srcdir}/${dir}" ]; then
            cp -a "${srcdir}/${dir}" "${pkgdir}/"
        fi
    done

    # Install license file if present
    if [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
